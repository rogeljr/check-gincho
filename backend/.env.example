# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/check_guincho
DB_HOST=localhost
DB_PORT=5432
DB_NAME=check_guincho
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui

# Server
PORT=3000
NODE_ENV=development

# JWT Secret (gere uma string aleatória segura)
JWT_SECRET=sua_chave_secreta_super_segura_aqui_min_32_caracteres

# Cloudinary (obtenha em https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=seu_cloud_name
CLOUDINARY_API_KEY=sua_api_key
CLOUDINARY_API_SECRET=sua_api_secret

# Mercado Pago (obtenha em https://www.mercadopago.com.br/developers)
# Para desenvolvimento: use credenciais TEST (começam com APP_TEST)
# Para produção: use credenciais PRODUÇÃO (começam com APP_USR)
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-seu_access_token_aqui
MERCADO_PAGO_PUBLIC_KEY=APP_USR-sua_public_key_aqui

# Email (Nodemailer - Gmail example)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=seu_email@gmail.com
EMAIL_PASSWORD=sua_senha_de_app
EMAIL_FROM="Check Guincho <seu_email@gmail.com>"

# Frontend URL (para webhooks e redirecionamentos)
FRONTEND_URL=http://localhost:8081
WEB_URL=http://localhost:3001
# Deep link do app (para definição de senha no aplicativo)
APP_URL=checkguincho://definir-senha
