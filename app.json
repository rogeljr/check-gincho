{
  "expo": {
    "name": "Check Guincho",
    "slug": "check-guincho",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/checkgincho.png",
    "scheme": "checkguincho",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/checkgincho.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Este aplicativo precisa acessar sua localização para registrar origem e destino dos sinistros.",
        "NSCameraUsageDescription": "Este aplicativo precisa acessar a câmera para tirar fotos dos veículos.",
        "NSPhotoLibraryUsageDescription": "Este aplicativo precisa acessar a galeria para selecionar fotos."
      }
    },
    "android": {
      "package": "com.checkguincho.app",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/checkgincho.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "407448c3-1ecb-4436-af0b-29124bb9deba"
      }
    },
    "owner": "rogeljr007"
  }
}
